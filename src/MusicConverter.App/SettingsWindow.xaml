<Window x:Class="MusicConverter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="90" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="DimGray" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,12" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
    <StackPanel Margin="16">
        <GroupBox Header="Safeguards" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Maximum nesting depth" FontWeight="SemiBold" />
                <TextBox Text="{Binding MaxNestingDepth, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="LilyPond and MEI levels allowed before a file fails. Prevents stack overflow crashes (10–1000)." />

                <TextBlock Text="Maximum input file size (MB)" FontWeight="SemiBold" />
                <TextBox Text="{Binding MaxInputMegabytes, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Text="Larger files are rejected before being read, bounding memory use (1–2048)." />

                <TextBlock Text="Maximum MIDI notes per file" FontWeight="SemiBold" />
                <TextBox Text="{Binding MaxMidiNotes, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Text="MIDI files with more notes are rejected (1,000–50,000,000)." />

                <TextBlock Text="Per-file timeout in batches (seconds)" FontWeight="SemiBold" />
                <TextBox Text="{Binding PerFileTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Text="A file taking longer is failed and the batch continues. 0 disables the limit." />

                <CheckBox Content="Convert each file in a separate worker process" IsChecked="{Binding IsolateProcesses}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="A crash or hang then only fails that file, and a timed-out file is terminated. Slower: each file pays a process start-up cost." />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Batch throttling" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Files converted at the same time" FontWeight="SemiBold" />
                <TextBox Text="{Binding MaxConcurrentFiles, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Text="1 is sequential and the safest (1–64). Higher values use more CPU and memory." />

                <CheckBox Content="Run at low priority" IsChecked="{Binding LowPriority}" />
                <TextBlock Style="{StaticResource Hint}" Text="Keeps the rest of the system responsive during a batch." />

                <TextBlock Text="Pause between files (milliseconds)" FontWeight="SemiBold" />
                <TextBox Text="{Binding DelayBetweenFilesMs, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Text="0–60000." />

                <TextBlock Text="Pause when memory use is above (%)" FontWeight="SemiBold" />
                <TextBox Text="{Binding PauseWhenMemoryAbovePercent, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                           Text="The batch waits before starting the next file until memory use drops (50–99). 0 disables." />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Verification" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox Content="Verify output after each conversion" IsChecked="{Binding VerifyOutput}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Re-reads the written file and compares parts, measures, notes, rests, ties, durations and pitches with the converted score. MIDI files are also compared with the source note count. Differences are reported but do not fail the file." />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Notifications and logging" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox Content="Show a notification when a batch completes" IsChecked="{Binding NotifyOnBatchComplete}" />
                <CheckBox Content="Play a sound when a batch completes" IsChecked="{Binding PlaySoundOnBatchComplete}" Margin="0,6,0,12" />

                <TextBlock Text="Log folder" FontWeight="SemiBold" />
                <TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" Width="Auto" HorizontalAlignment="Stretch" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,12"
                           Text="Leave empty for %LOCALAPPDATA%\MusicConverter\logs." />

                <CheckBox Content="Write a log file" IsChecked="{Binding FileLoggingEnabled}" Margin="0,0,0,8" />

                <TextBlock Text="Log file level" FontWeight="SemiBold" />
                <ComboBox x:Name="FileLevelBox" SelectedItem="{Binding FileLogLevel}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" />

                <TextBlock Text="Log panel level" FontWeight="SemiBold" />
                <ComboBox x:Name="UiLevelBox" SelectedItem="{Binding UiLogLevel}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" />

                <TextBlock Text="Delete log files older than (days)" FontWeight="SemiBold" />
                <TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                           Text="0 keeps all (0–3650). The folder, file options and retention take effect the next time the app starts; the panel level applies immediately." />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Error handling" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox Content="Lenient mode: skip malformed input with a warning" IsChecked="{Binding Lenient}" />
                <TextBlock Style="{StaticResource Hint}" Text="When off, the first malformed construct fails the file." />

                <TextBlock Text="Maximum skipped errors per file" FontWeight="SemiBold" />
                <TextBox Text="{Binding MaxRecoveries, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Text="Lenient mode gives up on a file after this many skipped errors." />

                <TextBlock Text="Maximum warnings per file" FontWeight="SemiBold" />
                <TextBox Text="{Binding MaxWarnings, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Further warnings are suppressed (1–100000)." />
            </StackPanel>
        </GroupBox>

        <DockPanel>
            <Button Content="Restore defaults" DockPanel.Dock="Left" Padding="12,4" Click="OnRestoreDefaults" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Padding="16,4" IsDefault="True" Click="OnSave" />
                <Button Content="Cancel" Padding="16,4" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
